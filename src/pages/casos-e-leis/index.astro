---
import Base from '../../layouts/Base.astro';
import { casos } from '../../data/casos.js';
import { getPadrao } from '../../data/padroes.js';
import { leis } from '../../data/leis.js';
---
<Base titulo="Casos e leis" descricao="Casos de empresas punidas por padrões enganosos e as leis brasileiras que tratam do tema, para fundamentar conversas com a gestão.">
  <section class="wrap cabecalho-pagina">
    <h1>Casos e leis</h1>
    <p class="lead">
      Padrões enganosos têm custo. Aqui estão empresas que foram multadas ou obrigadas a mudar suas interfaces, e as
      leis brasileiras que você pode citar quando precisar defender uma alternativa.
    </p>
    <div class="atalhos-topo">
      <a class="btn btn-primario" href="/casos-e-leis/leis/">Ver leis e normas</a>
      <a class="btn btn-secundario" href="/ferramentas/kit-de-argumentacao/">Usar no kit de argumentação</a>
    </div>
  </section>

  <div class="faixa tema-papel">
  <section class="wrap" aria-labelledby="t-casos">
    <h2 id="t-casos" class="secao-titulo">Casos reais</h2>
    <ul class="linhas casos">
      {casos.map((c) => (
        <li id={c.slug} class="caso">
          <div class="caso-topo">
            <div class="caso-id">
              <h3>{c.empresa}</h3>
              <p class="suave pequeno">{c.periodo}, {c.orgao}</p>
            </div>
            <p class="caso-resumo">{c.resumo}</p>
            <p class="caso-pena"><span class="suave pequeno">Consequência</span>{c.penalidadeCurta}</p>
          </div>
          <ul class="etiquetas">
            {c.padroes.map((s) => <li><a class="etiqueta" href={`/padroes/${s}/`}>{getPadrao(s).tecnico}</a></li>)}
          </ul>
          <details>
            <summary>Ver o caso completo</summary>
            <div class="caso-detalhe prosa leitura">
              <h4>O que aconteceu</h4>
              <p>{c.aconteceu}</p>
              <h4>Penalidade</h4>
              <p>{c.penalidade}</p>
              <h4>Lições para profissionais</h4>
              <ul>{c.licoes.map((l) => <li>{l}</li>)}</ul>
              <h4>Fontes</h4>
              <ul class="fontes">
                {c.fontes.map((f) => (
                  <li><a href={f.url} target="_blank" rel="noopener">{f.nome}<span class="visualmente-oculto"> (abre em nova aba)</span></a></li>
                ))}
              </ul>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </section>

  </div>

  <section class="wrap secao" aria-labelledby="t-leis">
    <h2 id="t-leis" class="secao-titulo">Leis e normas</h2>
    <ul class="linhas leis">
      {leis.map((l) => (
        <li>
          <a href={`/casos-e-leis/leis/#${l.slug}`}>
            <span class="lei-nome">{l.nome}</span>
            <span class="suave">{l.numero}. {l.papel}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .atalhos-topo { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }
  .caso { padding-block: var(--s5); display: grid; gap: var(--s4); scroll-margin-top: 96px; }
  .caso:target { box-shadow: inset 4px 0 0 var(--destaque); padding-left: var(--s4); }
  .caso-topo { display: grid; gap: var(--s3) var(--s6); }
  @media (min-width: 900px) {
    .caso-topo { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr) minmax(0, 0.6fr); align-items: start; }
  }
  .caso-id h3 { font-size: 1.5rem; }
  .caso-pena { display: grid; font-weight: 600; }
  details summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    cursor: pointer;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--sublinhado);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  details summary::marker { color: var(--destaque); }
  .caso-detalhe { padding-block: var(--s3) var(--s2); }
  .caso-detalhe h4 { margin-top: var(--s5); }
  .caso-detalhe h4:first-child { margin-top: 0; }
  .leis a { display: grid; gap: var(--s1); padding-block: var(--s5); text-decoration: none; }
  .lei-nome { font-family: var(--f-titulo); font-weight: 600; font-size: 1.25rem; }
  .leis a:hover .lei-nome { text-decoration: underline; text-decoration-color: var(--sublinhado); text-underline-offset: 4px; }
</style>

<script>
  // Abre o caso quando a página é acessada pelo link de uma ficha (ex.: #amazon).
  const abrir = () => {
    const id = decodeURIComponent(window.location.hash.slice(1));
    const caso = id ? document.getElementById(id) : null;
    caso?.querySelector('details')?.setAttribute('open', '');
  };
  abrir();
  window.addEventListener('hashchange', abrir);
</script>
