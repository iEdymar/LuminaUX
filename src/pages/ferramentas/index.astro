---
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';

const ferramentas = [
  { href: '/ferramentas/checklist/', nome: 'Checklist de revisão ética', texto: 'Perguntas de sim ou não para revisar uma tela antes de entregar. Cada “não” leva à ficha do padrão.', quando: 'Antes de entregar uma tela' },
  { href: '/ferramentas/arvore-de-decisao/', nome: 'Árvore de decisão', texto: 'Comece pelo que você vê na tela e chegue ao padrão em duas perguntas.', quando: 'Quando bate a dúvida' },
  { href: '/ferramentas/kit-de-argumentacao/', nome: 'Kit de argumentação', texto: 'Monte um argumento com problema, risco, alternativa e métrica, pronto para copiar.', quando: 'Antes da reunião com a gestão' },
  { href: '/ferramentas/roteiro-de-conversa/', nome: 'Roteiro de conversa', texto: 'Como levantar a questão com a liderança sem parecer que você está só dizendo não.', quando: 'Na conversa com o PM ou a liderança' },
  { href: '/ferramentas/registro-do-alerta/', nome: 'Registro do alerta', texto: 'Um texto-modelo para registrar que o risco foi apontado, quando a decisão não é sua.', quando: 'Depois da decisão' },
];
---
<Base titulo="Ferramentas" descricao="Checklist, árvore de decisão, kit de argumentação, roteiro de conversa e registro do alerta para o dia a dia de quem projeta interfaces.">
  <section class="wrap cabecalho-pagina">
    <h1>Ferramentas</h1>
    <p class="lead">
      Para usar no meio do trabalho: na dúvida diante de uma tela, antes de entregar, antes de uma reunião e depois
      de uma decisão.
    </p>
  </section>
  <section class="wrap">
    <ul class="linhas">
      {ferramentas.map((f) => (
        <li>
          <a class="ferramenta" href={f.href}>
            <span class="f-quando suave pequeno">{f.quando}</span>
            <span class="f-nome">{f.nome}</span>
            <span class="f-texto">{f.texto}</span>
            <span class="f-seta"><Icone nome="seta" /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .ferramenta {
    display: grid;
    gap: var(--s2) var(--s6);
    padding-block: var(--s6);
    text-decoration: none;
    grid-template-areas: 'quando' 'nome' 'texto';
  }
  @media (min-width: 900px) {
    .ferramenta {
      grid-template-columns: 220px minmax(0, 1fr) minmax(0, 1fr) 32px;
      grid-template-areas: 'quando nome texto seta';
      align-items: center;
    }
  }
  .f-quando { grid-area: quando; }
  .f-nome { grid-area: nome; font-family: var(--f-titulo); font-weight: 600; font-size: clamp(1.4rem, 1.1rem + 1vw, 1.875rem); letter-spacing: -0.015em; line-height: 1.15; }
  .f-texto { grid-area: texto; color: var(--suave); max-width: 46ch; }
  .f-seta { grid-area: seta; display: none; color: var(--neon); }
  .f-seta :global(svg) { width: 24px; height: 24px; transition: transform 160ms ease; }
  @media (min-width: 900px) { .f-seta { display: block; } }
  .ferramenta:hover .f-nome { text-decoration: underline; text-decoration-color: var(--neon); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .ferramenta:hover .f-seta :global(svg) { transform: translateX(4px); }
</style>
