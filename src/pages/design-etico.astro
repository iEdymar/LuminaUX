---
import Base from '../layouts/Base.astro';
import { principios } from '../data/principios.js';
import { getPadrao } from '../data/padroes.js';
---
<Base titulo="Design ético" descricao="Oito princípios para persuadir sem manipular, com boas práticas para o dia a dia e os padrões enganosos que cada um combate.">
  <section class="wrap cabecalho-pagina">
    <h1>Design ético</h1>
    <p class="lead">
      Design ético é projetar interfaces que ajudam as pessoas a decidir, em vez de decidir por elas. Os oito
      princípios abaixo reúnem o que a pesquisa em design, interação humano-computador e economia comportamental
      aponta como o limite entre persuadir e manipular.
    </p>
  </section>

  <div class="faixa tema-papel">
  <section class="wrap sumario-secao">
    <h2 class="visualmente-oculto">Os oito princípios</h2>
    <ol class="cartoes">
      {principios.map((p, i) => (
        <li>
          <a class="cartao" href={`#${p.slug}`}>
            <span class="cartao-numero">{i + 1}</span>
            <span class="cartao-nome">{p.nome}</span>
            <span class="cartao-frase">{p.frase}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {principios.map((p, i) => (
    <section class="wrap principio regua" id={p.slug} aria-labelledby={`t-${p.slug}`}>
      <div class="p-cabeca">
        <p class="p-numero" aria-hidden="true">{i + 1}</p>
        <h2 id={`t-${p.slug}`}>{p.nome}</h2>
        <p class="p-frase">{p.frase}</p>
      </div>
      <div class="p-corpo leitura">
        <div class="prosa">
          {p.texto.map((t) => <p>{t}</p>)}
        </div>
        {p.lista && (
          <dl class="p-lista">
            {p.lista.map(([termo, def]) => (
              <div><dt>{termo}</dt><dd>{def}</dd></div>
            ))}
          </dl>
        )}
        {p.textoFinal && <div class="prosa" style="margin-top: var(--s4)">{p.textoFinal.map((t) => <p>{t}</p>)}</div>}

        <h3>Na prática</h3>
        <ul class="pratica">
          {p.pratica.map((item) => <li>{item}</li>)}
        </ul>

        <div class="p-rodape">
          <div>
            <p class="rotulo">Combate</p>
            {!Array.isArray(p.combate) ? (
              <p>Todas as fichas do <a href="/padroes/">acervo</a>.</p>
            ) : (
              <ul class="etiquetas">
                {p.combate.map((s) => {
                  const f = getPadrao(s);
                  return <li><a class="etiqueta" href={`/padroes/${s}/`}>{f.tecnico}</a></li>;
                })}
              </ul>
            )}
          </div>
          <div>
            <p class="rotulo">Base</p>
            <p class="suave pequeno">{p.base}</p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="wrap secao">
    <p class="suave leitura pequeno">
      As referências completas estão na <a href="/biblioteca/">Biblioteca</a>. Para as leis que tratam desses temas,
      veja <a href="/casos-e-leis/leis/">Leis e normas</a>.
    </p>
  </section>
  </div>
</Base>

<style>
  .sumario-secao { padding-bottom: var(--s7); }
  .p-numero {
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 3rem;
    line-height: 1;
    color: var(--texto);
    margin-bottom: var(--s3);
  }

  .principio {
    display: grid;
    gap: var(--s5);
    padding-block: var(--s8);
    
  }
  @media (min-width: 960px) {
    .principio { grid-template-columns: 340px minmax(0, 1fr); gap: var(--s8); }
    .p-cabeca { position: sticky; top: 104px; align-self: start; }
  }
  .p-frase {
    margin-top: var(--s4);
    font-size: 1.1875rem;
    font-weight: 500;
    padding-left: var(--s4);
    border-left: 3px solid var(--texto);
    max-width: 28ch;
  }
  .p-lista { margin: var(--s5) 0 0; display: grid; gap: var(--s3); }
  .p-lista div { display: grid; grid-template-columns: minmax(120px, 0.4fr) 1fr; gap: var(--s4); padding-bottom: var(--s3); border-bottom: 1px solid var(--linha); }
  .p-lista dt { font-weight: 600; }
  .p-lista dd { margin: 0; }
  @media (max-width: 520px) { .p-lista div { grid-template-columns: 1fr; gap: var(--s1); } }
  .p-corpo h3 { margin: var(--s6) 0 var(--s3); }
  .pratica { list-style: none; padding: 0; display: grid; gap: var(--s3); }
  .pratica li { padding-left: var(--s5); position: relative; }
  .pratica li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 11px; height: 6px; border: 2.5px solid var(--destaque); border-top: 0; border-right: 0; transform: rotate(-45deg); }
  .p-rodape { display: grid; gap: var(--s5); margin-top: var(--s6); padding-top: var(--s5); border-top: 1px solid var(--linha); }
  @media (min-width: 720px) { .p-rodape { grid-template-columns: 1fr 1fr; } }
  .rotulo { font-weight: 600; margin-bottom: var(--s2); }
</style>
