---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada">
  <section class="wrap cabecalho-pagina">
    <h1>Esta página não existe.</h1>
    <p class="lead">O endereço pode ter mudado. Busque o padrão pelo que a tela faz ou volte para o início.</p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--s3);margin-top:var(--s6)">
      <a class="btn btn-primario" href="/padroes/">Buscar no acervo</a>
      <a class="btn btn-secundario" href="/">Ir para o início</a>
    </div>
  </section>
</Base>
