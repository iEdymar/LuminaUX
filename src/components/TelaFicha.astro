---
// Par de telas "Como aparece" e "Como evitar" para as três fichas completas.
// As marcações neon apontam onde olhar em cada versão.
const { padrao, versao } = Astro.props;
const errado = versao === 'errado';
---
<div class="tela inspecao">
  {padrao === 'urgencia-falsa' && (
    <>
      <div class="tela-barra" aria-hidden="true"><span></span><span></span><span></span><p>loja.exemplo/oferta</p></div>
      <div class="tela-corpo">
        <p class="tela-titulo">Fone Bluetooth Pro</p>
        <div class="linha-preco"><span class="miudo"><s>R$ 499,90</s></span><strong>R$ 299,90</strong></div>
        {errado ? (
          <>
            <div class="alvo aviso">Oferta termina em <span data-contador="598">09:58</span><span class="marcacao"><b>1</b>Contador que reinicia</span></div>
            <div class="alvo">Só restam 2 unidades!<span class="marcacao"><b>2</b>Estoque sem base real</span></div>
            <div class="alvo miudo">12 pessoas estão vendo agora<span class="marcacao"><b>3</b>Prova social sem contexto</span></div>
            <span class="botao-tela">Comprar agora</span>
          </>
        ) : (
          <>
            <div class="alvo aviso">Preço promocional válido até 30/11<span class="marcacao"><b>1</b>Prazo real e fixo</span></div>
            <div class="alvo">Em estoque<span class="marcacao"><b>2</b>Estoque verdadeiro</span></div>
            <span class="botao-tela">Comprar</span>
            <div class="alvo"><span class="botao-tela-sec">Salvar para depois</span><span class="marcacao"><b>3</b>Decidir sem pressa</span></div>
          </>
        )}
      </div>
    </>
  )}

  {padrao === 'pre-selecao' && (
    <>
      <div class="tela-barra" aria-hidden="true"><span></span><span></span><span></span><p>loja.exemplo/checkout</p></div>
      <div class="tela-corpo">
        <p class="tela-titulo">Resumo do pedido</p>
        <div class="linha-preco"><span>Fone Bluetooth Pro</span><span>R$ 299,90</span></div>
        {errado ? (
          <>
            <div class="alvo caixa"><span class="quadrado marcado" aria-hidden="true"></span><span>Proteção estendida por 12 meses + R$ 49,90</span><span class="marcacao"><b>1</b>Adicional já marcado</span></div>
            <div class="linha-preco total"><span>Total</span><span>R$ 349,80</span></div>
            <div class="alvo"><span class="botao-tela">Pagar agora</span><span class="marcacao"><b>2</b>Valor sem destaque</span></div>
          </>
        ) : (
          <>
            <div class="alvo caixa"><span class="quadrado" aria-hidden="true"></span><span>Adicionar proteção estendida por 12 meses, <strong>R$ 49,90</strong>. Cobre defeitos depois da garantia de fábrica.</span><span class="marcacao"><b>1</b>Desmarcado, com preço</span></div>
            <div class="linha-preco total"><span>Total</span><span>R$ 299,90</span></div>
            <div class="alvo"><span class="botao-tela">Pagar R$ 299,90</span><span class="marcacao"><b>2</b>O botão diz o valor</span></div>
          </>
        )}
      </div>
    </>
  )}

  {padrao === 'custos-ocultos' && (
    <>
      <div class="tela-barra" aria-hidden="true"><span></span><span></span><span></span><p>banco.exemplo/credito</p></div>
      <div class="tela-corpo">
        <p class="tela-titulo">Crédito pessoal</p>
        {errado ? (
          <>
            <div class="alvo"><p style="font-size:1.5rem;font-weight:700;line-height:1.2">R$ 5.000 na sua conta hoje</p><p>em 12x de R$ 520</p><span class="marcacao"><b>1</b>Só a parcela em destaque</span></div>
            <span class="botao-tela">Contratar agora</span>
            <div class="alvo link-tela">Ver condições<span class="marcacao"><b>2</b>Total e juros escondidos</span></div>
          </>
        ) : (
          <>
            <div class="alvo" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <div><p class="miudo">Você recebe</p><p style="font-size:1.375rem;font-weight:700">R$ 5.000</p></div>
              <div><p class="miudo">Você paga no total</p><p style="font-size:1.375rem;font-weight:700">R$ 6.240</p></div>
              <span class="marcacao"><b>1</b>Recebe e paga, lado a lado</span>
            </div>
            <div class="alvo" style="display:grid;gap:4px">
              <div class="linha-preco"><span>Parcelas</span><span>12x de R$ 520</span></div>
              <div class="linha-preco"><span>Juros</span><span>3,5% ao mês</span></div>
              <div class="linha-preco"><span>Custo Efetivo Total</span><span>52,9% ao ano</span></div>
              <span class="marcacao"><b>2</b>Condições na mesma tela</span>
            </div>
            <span class="botao-tela">Contratar e receber R$ 5.000</span>
          </>
        )}
      </div>
    </>
  )}

  {padrao === 'dificil-cancelar' && (
    <>
      <div class="tela-barra" aria-hidden="true"><span></span><span></span><span></span><p>streaming.exemplo/conta</p></div>
      <div class="tela-corpo">
        <p class="tela-titulo">Minha assinatura</p>
        <div class="linha-preco"><span>Plano Premium</span><strong>R$ 39,90 por mês</strong></div>
        {errado ? (
          <>
            <span class="botao-tela">Mudar de plano</span>
            <div class="alvo link-tela">Precisa de ajuda?<span class="marcacao"><b>1</b>Cancelar não aparece</span></div>
            <div class="alvo aviso">Para cancelar, ligue para 0800 000 0000, de segunda a sexta, das 9h às 18h.<span class="marcacao"><b>2</b>Só por telefone</span></div>
            <div class="alvo miudo">Antes de ligar, veja as 3 ofertas especiais que separamos para você.<span class="marcacao"><b>3</b>Retenção em várias etapas</span></div>
          </>
        ) : (
          <>
            <p class="miudo">Renova em 05/12.</p>
            <div class="duas-acoes">
              <span class="botao-tela-sec">Mudar de plano</span>
              <div class="alvo"><span class="botao-tela-sec">Cancelar assinatura</span><span class="marcacao"><b>1</b>Cancelar à vista</span></div>
            </div>
            <div class="alvo aviso">Antes de sair: 3 meses por R$ 19,90. Se preferir, é só continuar.<span class="marcacao"><b>2</b>Uma oferta, fácil de recusar</span></div>
            <div class="alvo miudo">O cancelamento vale na hora e você recebe o comprovante por e-mail. O acesso continua até 05/12.<span class="marcacao"><b>3</b>Efeito imediato e comprovante</span></div>
          </>
        )}
      </div>
    </>
  )}

  {padrao === 'misdirection' && (
    <>
      <div class="tela-barra" aria-hidden="true"><span></span><span></span><span></span><p>loja.exemplo/checkout</p></div>
      <div class="tela-corpo">
        <p class="tela-titulo">Antes de finalizar</p>
        {errado ? (
          <>
            <div class="aviso">Ganhe frete grátis com o Premium!</div>
            <div class="alvo"><span class="botao-tela">Quero frete grátis</span><span class="marcacao"><b>1</b>Opção da empresa em destaque</span></div>
            <div class="alvo link-tela">Não, prefiro pagar mais pelo frete<span class="marcacao"><b>2</b>Recusa apagada e que culpa</span></div>
            <div class="alvo miudo">R$ 14,90 por mês após 30 dias. Renovação automática.<span class="marcacao"><b>3</b>Condição em letras miúdas</span></div>
          </>
        ) : (
          <>
            <div class="alvo">
              <p>Quer experimentar o Premium? Frete grátis por <strong>R$ 14,90 por mês</strong>, com 30 dias grátis. Renova todo mês, e você pode cancelar quando quiser.</p>
              <span class="marcacao"><b>1</b>Condições visíveis</span>
            </div>
            <div class="alvo duas-acoes">
              <span class="botao-tela-sec">Assinar o Premium</span>
              <span class="botao-tela-sec">Continuar sem o Premium</span>
              <span class="marcacao"><b>2</b>Mesmo peso, texto neutro</span>
            </div>
          </>
        )}
      </div>
    </>
  )}

  {padrao === 'contratacao-escondida' && (
    <>
      <div class="tela-barra" aria-hidden="true"><span></span><span></span><span></span><p>cursos.exemplo/pagamento</p></div>
      <div class="tela-corpo">
        <p class="tela-titulo">Pagamento</p>
        <div class="linha-preco"><span>Curso de UX Writing</span><span>R$ 197,00</span></div>
        {errado ? (
          <>
            <div class="alvo linha-preco miudo"><span>Clube de descontos (mensal)</span><span>R$ 9,90</span><span class="marcacao"><b>1</b>Assinatura embutida no pedido</span></div>
            <div class="linha-preco total"><span>Total</span><span>R$ 206,90</span></div>
            <div class="alvo"><span class="botao-tela">Continuar</span><span class="marcacao"><b>2</b>O botão não diz o que contrata</span></div>
            <p class="miudo">Ao continuar, você concorda com os termos.</p>
          </>
        ) : (
          <>
            <div class="linha-preco total"><span>Total</span><span>R$ 197,00</span></div>
            <div class="alvo aviso">
              <p>Opcional: clube de descontos por R$ 9,90 por mês. Renova todo mês, cancele quando quiser.</p>
              <span class="botao-tela-sec" style="margin-top:10px">Adicionar o clube</span>
              <span class="marcacao"><b>1</b>Oferta separada, com aceite próprio</span>
            </div>
            <div class="alvo"><span class="botao-tela">Pagar R$ 197,00</span><span class="marcacao"><b>2</b>O botão diz a ação e o valor</span></div>
          </>
        )}
      </div>
    </>
  )}

  {padrao === 'privacy-zuckering' && (
    <>
      <div class="tela-barra" aria-hidden="true"><span></span><span></span><span></span><p>app.exemplo/boas-vindas</p></div>
      <div class="tela-corpo">
        {errado ? (
          <>
            <p class="tela-titulo">Personalize sua experiência</p>
            <div class="alvo caixa"><span class="quadrado marcado" aria-hidden="true"></span><span>Aceito os Termos de Uso, a Política de Privacidade e o compartilhamento dos meus dados com parceiros.</span><span class="marcacao"><b>1</b>Dados junto com os termos</span></div>
            <span class="botao-tela">Aceitar e continuar</span>
            <div class="alvo link-tela">Gerenciar preferências<span class="marcacao"><b>2</b>Recusar exige outras telas</span></div>
          </>
        ) : (
          <>
            <p class="tela-titulo">Sua privacidade</p>
            <div class="caixa"><span class="quadrado" aria-hidden="true"></span><span>Li e aceito os Termos de Uso (obrigatório).</span></div>
            <div class="alvo caixa"><span class="quadrado" aria-hidden="true"></span><span>Compartilhar dados de uso com parceiros para mostrar anúncios (opcional).</span><span class="marcacao"><b>1</b>Opcional, separado e desmarcado</span></div>
            <span class="botao-tela">Continuar</span>
            <div class="alvo miudo">Você pode mudar essa escolha quando quiser em Configurações, Privacidade.<span class="marcacao"><b>2</b>Fácil de revogar</span></div>
          </>
        )}
      </div>
    </>
  )}
</div>

<style>
  .tela { width: 100%; }
  .tela .alvo { padding: 2px 0; }
  .duas-acoes { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-items: end; }
  .duas-acoes .marcacao { left: 6px; }
</style>

<script>
  document.querySelectorAll('.inspecao [data-contador]').forEach((el) => {
    let resta = Number(el.getAttribute('data-contador')) || 600;
    const f = (s: number) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    setInterval(() => {
      resta = resta <= 0 ? 600 : resta - 1;
      el.textContent = f(resta);
    }, 1000);
  });
</script>
