---
import { site } from '../data/site.js';

// Colunas de links do rodapé. Para trocar um link, mude aqui.
const colunas = [
  {
    titulo: 'Explorar',
    links: [
      { href: '/padroes/', label: 'Padrões enganosos' },
      { href: '/design-etico/', label: 'Design ético' },
      { href: '/casos-e-leis/', label: 'Casos e leis' },
    ],
  },
  {
    titulo: 'Ferramentas',
    links: [
      { href: '/ferramentas/checklist/', label: 'Checklist de revisão' },
      { href: '/ferramentas/kit-de-argumentacao/', label: 'Kit de argumentação' },
      { href: '/ferramentas/roteiro-de-conversa/', label: 'Roteiro de conversa' },
    ],
  },
];
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="wrap">
    <div class="rodape-grade">
      {colunas.map((c) => (
        <nav aria-labelledby={`rodape-${c.titulo}`}>
          <p class="rodape-titulo" id={`rodape-${c.titulo}`}>{c.titulo}</p>
          <ul class="rodape-links">
            {c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}

      <div class="rodape-projeto">
        <p class="rodape-aviso">Conteúdo informativo, baseado em pesquisa acadêmica. Não substitui orientação jurídica.</p>
        <p class="rodape-credito">
          Trabalho de Conclusão de Curso em Design Digital na Universidade Federal do Ceará, Campus Quixadá.
          Feito por {site.autor}, com orientação da {site.orientadora.nome}. Atualizado em {site.atualizado}.
        </p>
        <dl class="rodape-contatos">
          <div>
            <dt>{site.autor}</dt>
            <dd>
              <a href={site.linkedin} rel="noopener" target="_blank">LinkedIn<span class="visualmente-oculto"> (abre em nova aba)</span></a>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </dd>
          </div>
          <div>
            <dt>{site.orientadora.nomeCurto}</dt>
            <dd><a href={`mailto:${site.orientadora.email}`}>{site.orientadora.email}</a></dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="rodape-base">
      <p>© {ano} {site.nome}</p>
      <ul>
        <li><a href="/sobre/">Sobre o hub</a></li>
        <li><a href="/biblioteca/">Biblioteca</a></li>
      </ul>
    </div>
  </div>

  <!-- Nome gigante esmaecido, cortado na base (como letreiro). É decoração: leitores de tela ignoram. -->
  <div class="wrap rodape-letreiro" aria-hidden="true">
    <svg viewBox="0 0 498.2 74" preserveAspectRatio="xMidYMin meet">
      <defs>
        <!-- Esmaecido de cima para baixo. Fica todo branco: neon transparente sobre o azul vira verde-oliva. -->
        <linearGradient id="letreiro" x1="0" y1="0" x2="0" y2="74" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#efefef" stop-opacity="0.42" />
          <stop offset="1" stop-color="#efefef" stop-opacity="0.06" />
        </linearGradient>
      </defs>
      <path fill="url(#letreiro)" d="M17.1 66.9H39.5V80.1H0V9.9H17.1ZM99.8 24.3V80.1H82.7V72.5Q80.1 76.2 75.7 78.5Q71.2 80.7 65.8 80.7Q59.4 80.7 54.5 77.9Q49.6 75 46.9 69.6Q44.2 64.2 44.2 56.9V24.3H61.2V54.6Q61.2 60.2 64.1 63.3Q67 66.4 71.9 66.4Q76.9 66.4 79.8 63.3Q82.7 60.2 82.7 54.6V24.3ZM203 47.5V80.1H186V49.8Q186 44.4 183.2 41.5Q180.3 38.5 175.3 38.5Q170.3 38.5 167.5 41.5Q164.6 44.4 164.6 49.8V80.1H147.6V49.8Q147.6 44.4 144.8 41.5Q141.9 38.5 136.9 38.5Q131.9 38.5 129.1 41.5Q126.2 44.4 126.2 49.8V80.1H109.1V24.3H126.2V31.3Q128.8 27.8 133 25.8Q137.2 23.7 142.5 23.7Q148.8 23.7 153.8 26.4Q158.7 29.1 161.5 34.1Q164.4 29.5 169.4 26.6Q174.4 23.7 180.3 23.7Q190.7 23.7 196.9 30Q203 36.3 203 47.5ZM210.4 9.3Q210.4 5.3 213.2 2.7Q216.1 0 220.6 0Q225 0 227.9 2.7Q230.7 5.3 230.7 9.3Q230.7 13.2 227.9 15.9Q225 18.5 220.6 18.5Q216.1 18.5 213.2 15.9Q210.4 13.2 210.4 9.3ZM229.1 24.3V80.1H212V24.3ZM294 47.5V80.1H277V49.8Q277 44.2 274.1 41.1Q271.2 38 266.3 38Q261.4 38 258.5 41.1Q255.6 44.2 255.6 49.8V80.1H238.5V24.3H255.6V31.7Q258.2 28 262.6 25.9Q267 23.7 272.5 23.7Q282.3 23.7 288.1 30.1Q294 36.4 294 47.5ZM324.1 23.5Q330 23.5 334.5 25.9Q338.9 28.3 341.3 32.2V24.3H358.4V80.1H341.3V72.2Q338.8 76.1 334.4 78.5Q329.9 80.9 324 80.9Q317.2 80.9 311.6 77.4Q306 73.8 302.8 67.2Q299.5 60.7 299.5 52.1Q299.5 43.5 302.8 37Q306 30.5 311.6 27Q317.2 23.5 324.1 23.5ZM329.1 38.4Q324 38.4 320.5 42.1Q316.9 45.7 316.9 52.1Q316.9 58.5 320.5 62.2Q324 66 329.1 66Q334.2 66 337.8 62.3Q341.3 58.6 341.3 52.2Q341.3 45.8 337.8 42.1Q334.2 38.4 329.1 38.4Z" />
      <path fill="url(#letreiro)" d="M384.6 9.9V51.9Q384.6 58.2 387.7 61.6Q390.8 65 396.8 65Q402.8 65 406 61.6Q409.2 58.2 409.2 51.9V9.9H426.3V51.8Q426.3 61.2 422.3 67.7Q418.3 74.2 411.6 77.5Q404.8 80.8 396.5 80.8Q388.2 80.8 381.7 77.6Q375.1 74.3 371.3 67.8Q367.5 61.2 367.5 51.8V9.9ZM478.3 80.1 464 58.6 451.4 80.1H432L454.5 44.4L431.5 9.9H451.4L465.5 31.1L477.9 9.9H497.3L475 45.3L498.2 80.1Z" />
    </svg>
  </div>
</footer>

<style>
  .rodape {
    border-top: 1px solid var(--linha);
    padding-top: var(--s8);
    overflow: hidden;
  }
  .rodape-grade {
    display: grid;
    gap: var(--s6) var(--s5);
    grid-template-columns: 1fr 1fr;
  }
  .rodape-projeto { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .rodape-grade { grid-template-columns: 1fr 1fr 2fr; gap: var(--s7); }
    .rodape-projeto { grid-column: auto; }
  }

  .rodape-titulo {
    font-family: var(--f-titulo);
    font-weight: 600;
    font-size: 1.0625rem;
    margin-bottom: var(--s3);
  }
  .rodape-links { list-style: none; padding: 0; display: grid; gap: var(--s1); }
  .rodape-links a,
  .rodape-base a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 0.9375rem;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .rodape-links a:hover,
  .rodape-base a:hover { color: var(--texto); text-decoration: underline; text-decoration-color: var(--sublinhado); }

  .rodape-aviso {
    font-family: var(--f-titulo);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.35;
    max-width: 36ch;
  }
  .rodape-credito { margin-top: var(--s4); color: var(--texto-suave); font-size: 0.9375rem; max-width: 56ch; }
  .rodape-contatos { margin: var(--s5) 0 0; display: grid; gap: var(--s3); font-size: 0.9375rem; }
  .rodape-contatos div { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s1) var(--s4); }
  .rodape-contatos dt { font-weight: 600; min-width: 108px; }
  .rodape-contatos dd { margin: 0; display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); }
  .rodape-contatos a { display: inline-flex; align-items: center; min-height: 32px; overflow-wrap: anywhere; }
  @media (max-width: 520px) { .rodape-contatos div { flex-direction: column; gap: 0; } }

  .rodape-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s3) var(--s5);
    margin-top: var(--s7);
    padding-top: var(--s4);
    border-top: 1px solid var(--linha);
    font-size: 0.9375rem;
    color: var(--texto-suave);
  }
  .rodape-base ul { list-style: none; padding: 0; display: flex; gap: var(--s5); }

  .rodape-letreiro { margin-top: var(--s6); }
  .rodape-letreiro svg { width: 100%; height: auto; }
</style>
