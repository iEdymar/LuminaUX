---
// Tela de checkout com quatro padrões escondidos. O botão "Revelar padrões" liga a camada de inspeção.
---
<figure class="demo">
  <div class="demo-topo">
    <p class="demo-rotulo">Um checkout comum. Quantos padrões enganosos você encontra?</p>
    <button class="btn btn-primario btn-pequeno" type="button" id="revelar" aria-pressed="false" aria-controls="tela-demo">
      <!-- Os dois textos ocupam o mesmo lugar: o botão já nasce com a largura do maior e não pula de linha -->
      <span class="revelar-texto" data-estado="desligado">Revelar padrões</span>
      <span class="revelar-texto" data-estado="ligado" hidden>Esconder padrões</span>
    </button>
  </div>

  <div class="tela inspecao-controlada" id="tela-demo">
    <div class="tela-barra" aria-hidden="true"><span></span><span></span><span></span><p>loja.exemplo/checkout</p></div>
    <div class="tela-corpo">
      <p class="tela-titulo">Finalizar compra</p>

      <div class="linha-preco">
        <span>Fone Bluetooth Pro</span>
        <span>R$ 299,90</span>
      </div>

      <div class="alvo aviso">
        Oferta termina em <span data-contador="598">09:58</span>
        <a class="marcacao" href="/padroes/urgencia-falsa/"><b>1</b>Urgência falsa</a>
      </div>

      <div class="alvo caixa">
        <span class="quadrado marcado" aria-hidden="true"></span>
        <span>Proteção estendida por 12 meses <strong>+ R$ 49,90</strong></span>
        <a class="marcacao" href="/padroes/pre-selecao/"><b>2</b>Pré-seleção</a>
      </div>

      <div>
        <div class="linha-preco miudo"><span>Subtotal</span><span>R$ 349,80</span></div>
        <div class="alvo linha-preco miudo taxa">
          <span>Taxa de serviço</span><span>R$ 14,90</span>
          <a class="marcacao" href="/padroes/custos-ocultos/"><b>3</b>Custo oculto</a>
        </div>
      </div>

      <div class="linha-preco total"><span>Total</span><span>R$ 364,70</span></div>

      <span class="botao-tela">Pagar agora</span>

      <div class="alvo link-tela">
        Não, prefiro arriscar sem proteção
        <a class="marcacao" href="/padroes/misdirection/"><b>4</b>Misdirection</a>
      </div>
    </div>
  </div>

  <figcaption class="demo-legenda" aria-live="polite" id="demo-legenda">
    Tela fictícia, criada para este hub.
  </figcaption>
</figure>

<style>
  .demo { margin: 0; display: grid; gap: var(--s4); }
  .demo-topo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s3) var(--s4);
  }
  #revelar { display: inline-grid; }
  #revelar .revelar-texto { grid-area: 1 / 1; }
  #revelar .revelar-texto[hidden] { display: block; visibility: hidden; }
  @media (max-width: 400px) {
    .demo-topo { grid-template-columns: 1fr; justify-items: start; }
  }
  .demo-rotulo { font-weight: 600; max-width: 30ch; }
  .demo .tela { max-width: 420px; width: 100%; justify-self: center; }
  /* Duas linhas reservadas: a legenda muda de texto sem empurrar o resto */
  .demo-legenda { font-size: 0.875rem; line-height: 1.5; min-height: 3em; color: var(--suave); text-align: center; }
  .demo .alvo { padding: 2px 0; }
  .demo .alvo.caixa { padding-right: 4px; }
  /* O espaço das marcações fica reservado desde o início: revelar não empurra a página */
  .demo .alvo { margin-top: 18px; }
  .demo .taxa { margin-top: 26px; }
</style>

<script>
  const botao = document.getElementById('revelar');
  const tela = document.getElementById('tela-demo');
  const legenda = document.getElementById('demo-legenda');
  botao?.addEventListener('click', () => {
    const ligado = botao.getAttribute('aria-pressed') === 'true';
    botao.setAttribute('aria-pressed', String(!ligado));
    tela?.classList.toggle('revelado', !ligado);
    botao.querySelectorAll<HTMLElement>('.revelar-texto').forEach((t) => {
      t.hidden = t.dataset.estado !== (ligado ? 'desligado' : 'ligado');
    });
    if (legenda) {
      legenda.textContent = ligado
        ? 'Tela fictícia, criada para este hub.'
        : '4 padrões nesta tela. Toque em cada marcação para abrir a ficha.';
    }
  });

  // Contadores falsos: quando chegam a zero, voltam ao início (é assim que a urgência falsa costuma funcionar).
  document.querySelectorAll('[data-contador]').forEach((el) => {
    const inicio = Number(el.getAttribute('data-contador')) || 600;
    let resta = inicio;
    const formatar = (s: number) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    setInterval(() => {
      resta = resta <= 0 ? 600 : resta - 1;
      el.textContent = formatar(resta);
    }, 1000);
  });
</script>